#!/usr/bin/env bash
# 描述：获取 Arch Linux 最新新闻
# 用法：anews [数量] [cn|official] [help]

set -euo pipefail

# 帮助信息
show_help() {
    cat << 'HELPEOF'
\033[1;36mArch Linux 新闻获取工具\033[0m

\033[1;33m用法:\033[0m
    anews [选项] [数量] [新闻源]

\033[1;33m参数说明:\033[0m
    \033[1;32m数量\033[0m         要显示的新闻条数（正整数），默认 15 条
    \033[1;32mcn\033[0m           使用 Arch Linux CN 中文新闻源
    \033[1;32mofficial\033[0m     使用 Arch Linux 官方新闻源（默认）
    \033[1;32mhelp\033[0m         显示此帮助信息

\033[1;33m使用示例:\033[0m
    \033[1;37manews\033[0m                    # 显示官方最新 15 条新闻
    \033[1;37manews 10\033[0m                 # 显示官方最新 10 条新闻
    \033[1;37manews cn\033[0m                 # 显示中文源最新 15 条新闻
    \033[1;37manews 10 cn\033[0m             # 显示中文源最新 10 条新闻
    \033[1;37manews 20 official\033[0m       # 显示官方源最新 20 条新闻
    \033[1;37manews help\033[0m              # 显示此帮助信息

\033[1;33m颜色说明:\033[0m
    \033[1;32m绿色标题\033[0m     普通新闻
    \033[1;31m红色标题\033[0m     需要手动干预的重要新闻（包含 intervention/manual/手动/干预 关键词）

\033[1;33m退出状态:\033[0m
    0   成功获取并显示新闻
    1   网络连接失败、内容为空或解析错误

\033[1;33m依赖:\033[0m
    bash, curl, python3 (需标准库 xml.etree.ElementTree)
HELPEOF
}

# 默认配置
count=15
source="official"
show_help_flag=0

# 解析命令行参数
for arg in "$@"; do
    if [[ $arg == "help" || $arg == "--help" || $arg == "-h" ]]; then
        show_help_flag=1
    elif [[ $arg =~ ^[0-9]+$ ]]; then
        count=$arg
    elif [[ $arg == "cn" || $arg == "official" ]]; then
        source=$arg
    else
        echo "错误：未知参数 '$arg'。使用 'anews help' 查看帮助信息" >&2
        exit 1
    fi
done

if [[ $show_help_flag -eq 1 ]]; then
    # 使用 echo -e 解释转义序列以正确显示颜色
    help_text=$(show_help)
    echo -e "$help_text"
    exit 0
fi

if [[ $source == "cn" ]]; then
    feed_url="https://www.archlinuxcn.org/category/news/feed/"
    feed_label="Arch Linux CN"
else
    feed_url="https://archlinux.org/feeds/news/"
    feed_label="Arch Linux 官方"
fi

# 内嵌 Python 解析脚本
python_script=$(cat << 'PYEOF'
import sys
import xml.etree.ElementTree as ET

INTERVENTION_KEYWORDS = {"intervention", "manual", "手动", "干预"}

def sanitize(text: str) -> str:
    return "".join(c for c in text if ord(c) > 31)

def main():
    try:
        limit = int(sys.argv[1])
    except (IndexError, ValueError):
        limit = 15

    xml_data = sys.stdin.read()
    if not xml_data.strip():
        raise ValueError("收到的 XML 内容为空，请检查网络或新闻源")

    root = ET.fromstring(xml_data)
    items = root.findall("./channel/item")[:limit]

    if not items:
        raise ValueError("XML 中未找到任何新闻条目，可能新闻源格式已变化")

    print(f"\n\033[1;33m最近 {len(items)} 条 {sys.argv[2]} 新闻：\033[0m\n")

    for item in items:
        title = (item.findtext("title") or "").strip()
        # 日期通常形如 "Mon, 03 Aug 2026 ..."，截取前16个字符即可
        pub_date = (item.findtext("pubDate") or "")[:16]
        link = (item.findtext("link") or "").strip()

        # 检测是否需要手动干预
        is_intervention = any(kw in title.lower() for kw in INTERVENTION_KEYWORDS)

        # 根据类型设定颜色和前缀
        if is_intervention:
            color = "\033[1;31m"   # 红色
            prefix = "!!! "
        else:
            color = "\033[1;32m"   # 绿色
            prefix = ""

        # 构建带超链接的标题
        if link:
            safe_link = sanitize(link)
            display_title = f"\033]8;;{safe_link}\033\\{prefix}{title}\033]8;;\033\\"
        else:
            display_title = f"{prefix}{title}"

        print(f"{color}[{pub_date}] {display_title}\033[0m")

    print(f"\n\033[1;33m新闻来源: {sys.argv[2]} ({sys.argv[3]})\033[0m")

if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        sys.stderr.write(f"解析错误: {e}\n")
        sys.exit(1)
PYEOF
)

# 获取并解析新闻
# 抓取 XML 内容
if ! xml_content=$(curl -fsSL --connect-timeout 10 --compressed \
                    -A "Mozilla/5.0" "$feed_url" 2>/dev/null); then
    echo -e "\n\033[1;31m[错误]\033[0m 无法连接到新闻源 ($feed_label)，请检查网络" >&2
    echo "URL: $feed_url" >&2
    exit 1
fi

if [[ -z "$xml_content" ]]; then
    echo -e "\n\033[1;31m[错误]\033[0m 获取的新闻内容为空 ($feed_label)" >&2
    exit 1
fi

# 交给 Python 解析
if ! printf '%s' "$xml_content" | python3 -c "$python_script" "$count" "$feed_label" "$feed_url"; then
    echo -e "\n\033[1;31m[错误]\033[0m 新闻解析失败" >&2
    exit 1
fi
